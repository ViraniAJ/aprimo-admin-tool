{
  "name": "aprimo-admin-tools",
  "version": "1.1.0",
  "description": "Standalone desktop admin tools for Aprimo \u2014 classifications exporter, data model explorer, bulk versioning, and more.",
  "main": "electron/main.js",
  "author": "",
  "license": "BSD-3-Clause",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "npm run bundle:all && electron-builder --win",
    "build:mac": "npm run bundle:all && electron-builder --mac",
    "build:linux": "npm run bundle:all && electron-builder --linux",
    "bundle": "esbuild renderer/app.js --bundle --format=iife --outfile=renderer/bundle.js --platform=browser",
    "prestart": "npm run bundle:all",
    "prebuild": "npm run bundle:all",
    "bundle:bv": "esbuild bulk-versioning/src/main.tsx --bundle --format=iife --outfile=renderer/bulk-versioning.js --platform=browser --jsx=automatic --tsconfig=bulk-versioning/tsconfig.json --minify --log-level=warning",
    "css:bv": "tailwindcss -i bulk-versioning/src/styles.css -o renderer/bulk-versioning.css --minify",
    "typecheck:bv": "tsc -p bulk-versioning/tsconfig.json",
    "bundle:all": "npm run bundle && npm run bundle:bv && npm run css:bv"
  },
  "dependencies": {
    "aprimo-js": "^2.3.0",
    "cytoscape": "^3.34.3",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.564.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.aprimo.admin-tools",
    "productName": "Aprimo Admin Tools",
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
